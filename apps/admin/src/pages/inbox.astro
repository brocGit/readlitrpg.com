---
import { decideInboxItem, decideWithHandler, getInboxItem, listOpenInbox } from "@rlr/core/inbox";
import { INBOX_HANDLERS } from "@rlr/core/inbox/handlers";
import { can } from "@rlr/core/policy";
import Console from "../layouts/Console.astro";
import { adminActor } from "../lib/admin-session";
import { audit, flash, readForm } from "../lib/forms";
import { getDb, renderEnv } from "../lib/runtime";

const admin = await Astro.locals.admin();
if (!admin) return Astro.redirect("/signin", 303);
const db = getDb();

if (Astro.request.method === "POST") {
  const form = await readForm(Astro.request);
  if (!can(adminActor(admin), "inbox.decide").ok)
    return Astro.redirect(flash("/inbox", "Not allowed", "error"), 303);
  const status =
    form.decision === "rejected" ? "rejected" : form.decision === "approved" ? "approved" : "resolved";
  const item = await getInboxItem(db, form.id ?? "");
  // Author items do something when decided: publish the listing, apply the change, verify (M6).
  const handled = item && status !== "resolved" && INBOX_HANDLERS[item.type];
  const changed = !item
    ? false
    : handled
      ? await decideWithHandler(db, item, status === "approved" ? "approve" : "reject", INBOX_HANDLERS, {
          decidedBy: admin.userId,
          note: form.note || undefined,
          now: new Date(),
          settings: await Astro.locals.settings(),
          renderEnv: renderEnv(),
        })
      : await decideInboxItem(db, item.id, { status, decidedBy: admin.userId, note: form.note || undefined });
  if (changed) {
    await audit(admin, Astro.locals.requestId, {
      action: "inbox.decide",
      subjectType: "inbox_item",
      subjectId: form.id,
      diff: { status, type: item?.type ?? null, note: form.note || null },
    });
  }
  return Astro.redirect(
    flash(
      "/inbox",
      changed ? `Marked ${status}.` : "That item was already closed.",
      changed ? "ok" : "error",
    ),
    303,
  );
}

const items = await listOpenInbox(db, 200);
const isPair = (p: unknown): p is { bookId: string; otherId: string; reason: string } =>
  typeof p === "object" && p !== null && "bookId" in p && "otherId" in p;
const field = (p: unknown, key: string): string | null => {
  const v = typeof p === "object" && p !== null ? (p as Record<string, unknown>)[key] : null;
  return typeof v === "string" ? v : null;
};
const recommendation: Record<string, string> = {
  approve: "Recommends: approve",
  reject: "Recommends: reject",
  edit: "Recommends: edit, then approve",
  escalate: "Needs your judgment",
};
---

<Console title="Inbox">
  {
    items.length === 0 ? (
      <div class="status-screen">
        <p class="label">[Quest log empty]</p>
        <p>Nothing needs you right now.</p>
      </div>
    ) : (
      <table>
        <thead>
          <tr><th>Priority</th><th>Item</th><th>Opened</th><th>Decide</th></tr>
        </thead>
        <tbody>
          {items.map((item) => (
            <tr>
              <td>{item.priority}</td>
              <td>
                <strong>{item.title}</strong>
                <div class="muted">{item.type}{item.subjectType ? ` · ${item.subjectType} ${item.subjectId ?? ""}` : ""}</div>
                {item.aiSummary && <p>{item.aiSummary}</p>}
                {item.aiRecommendation && <p class="muted">{recommendation[item.aiRecommendation]}</p>}
                {item.type === "classification_review" && field(item.payload, "proposalId") && (
                  <form method="post" action="/editorial" class="inline">
                    <input type="hidden" name="proposal" value={field(item.payload, "proposalId") ?? ""} />
                    <input type="hidden" name="back" value="/inbox" />
                    <button class="button small" name="action" value="apply" type="submit">Apply the classification</button>
                    <button class="button small secondary" name="action" value="discard" type="submit">Discard it</button>
                    {field(item.payload, "bookId") && <a href={`/catalog/books/${field(item.payload, "bookId")}`}>the book</a>}
                  </form>
                )}
                {item.type === "editorial_run_held" && field(item.payload, "runId") && (
                  <p><a href={`/editorial/runs/${field(item.payload, "runId")}`}>Review the run's held proposals</a></p>
                )}
                {(item.type === "seed_check" || item.type === "scope_check") && field(item.payload, "bookId") && (
                  <p><a href={`/catalog/books/${field(item.payload, "bookId")}`}>Open the book</a> to hide it, fix it, or override the field.</p>
                )}
                {item.type === "quiz_ready" && field(item.payload, "slug") && (
                  <p><a href={`/quizzes?preview=${field(item.payload, "slug")}`}>Preview it</a>, then publish or retire it from Quizzes.</p>
                )}
                {item.type === "possible_duplicate" && isPair(item.payload) && (
                  <p>
                    Compare <a href={`/catalog/books/${item.payload.bookId}`}>this book</a> with{" "}
                    <a href={`/catalog/books/${item.payload.otherId}`}>the existing one</a> ({item.payload.reason}). Merge from the
                    book page if they're the same; resolve here if not.
                  </p>
                )}
                {item.subjectType === "submission" && (
                  <p>
                    <strong>{field(item.payload, "title")}</strong> by {field(item.payload, "authorName")} ({field(item.payload, "genre")}). Approve publishes it; reject tells the author why (use the note).
                    {field(item.payload, "duplicateOf") && <> It may be <a href={`/catalog/books/${field(item.payload, "duplicateOf")}`}>this existing book</a>.</>}
                    {field(item.payload, "authorId") && <> <a href={`/catalog/authors/${field(item.payload, "authorId")}`}>The author's profile</a>.</>}
                  </p>
                )}
                {item.type === "protected_change" && (
                  <p>
                    {field(item.payload, "reason")}. <a href={`/catalog/books/${field(item.payload, "bookId")}`}>The book</a> · the change is under Details. Approve applies it as the author.
                  </p>
                )}
                {item.type === "verification_manual" && (
                  <p>
                    Look for <code>{field(item.payload, "code")}</code> at <strong>{field(item.payload, "target")}</strong> ({field(item.payload, "method")}). {field(item.payload, "check")}{" "}
                    <a href={`/catalog/authors/${field(item.payload, "authorId")}`}>The profile</a>.
                  </p>
                )}
                {item.type === "claim_conflict" && (
                  <p>
                    Someone else claims <a href={`/catalog/authors/${field(item.payload, "authorId")}`}>{field(item.payload, "name")}</a>, which already has members. Approve adds them as an owner (you can remove members on the profile page).
                  </p>
                )}
                {item.type === "guest_pitch" && (
                  <p>
                    <strong>{field(item.payload, "title")}</strong>: {field(item.payload, "pitch")} · <a href={`/blog/${field(item.payload, "postId")}`}>The post</a>. Approve accepts the pitch; reject declines it (the note goes to the author).
                  </p>
                )}
                {item.type === "news_brief" && (
                  <div>
                    <p><strong>{field(item.payload, "headline")}</strong></p>
                    <p>{field(item.payload, "body")}</p>
                    <p class="muted">{field(item.payload, "why")}</p>
                    <ul>
                      {((item.payload as { sources?: { url: string }[] } | null)?.sources ?? []).map((s) => (
                        <li><a href={s.url} rel="noopener noreferrer">{s.url}</a></li>
                      ))}
                    </ul>
                    <p class="muted">Approve publishes it as a news brief citing these pages.</p>
                  </div>
                )}
                {item.type === "post_review" && (
                  <p>
                    <a href={`/blog/${field(item.payload, "postId") ?? item.subjectId}`}>Read it in the editor</a>. Approve
                    publishes it (guest posts and interviews take their calendar slot); reject keeps it off the site.
                  </p>
                )}
                {item.type === "author_report" && (
                  <p>{field(item.payload, "text")} · <a href={`/catalog/books/${field(item.payload, "bookId")}`}>The book</a></p>
                )}
                {item.payload != null && (
                  <details>
                    <summary>Details</summary>
                    <pre>{JSON.stringify(item.payload, null, 2)}</pre>
                  </details>
                )}
              </td>
              <td>{item.createdAt.slice(0, 16).replace("T", " ")}</td>
              <td>
                <form method="post" class="inline">
                  <input type="hidden" name="id" value={item.id} />
                  <input type="text" name="note" placeholder="Note (optional)" maxlength="500" />
                  {INBOX_HANDLERS[item.type] && (item.subjectType === "submission" || !["possible_duplicate", "scope_check"].includes(item.type)) ? (
                    <>
                      <button class="button small" name="decision" value="approved" type="submit">Approve</button>
                      <button class="button small secondary" name="decision" value="rejected" type="submit">Reject</button>
                    </>
                  ) : (
                    <button class="button small" name="decision" value="resolved" type="submit">Resolve</button>
                  )}
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</Console>
