---
import { appendAudit } from "@rlr/core/audit";
import {
  CLOSE_ONLY_DEFAULT_TYPES,
  countdown,
  countSnoozed,
  decideInboxItem,
  decideWithHandler,
  getInboxItem,
  type InboxItem,
  isLowRisk,
  itemAuthorId,
  listOpenInbox,
  REJECT_REASONS,
  rejectNote,
  SNOOZE_CHOICES,
  snoozeInboxItem,
  trustAuthor,
  wakeInboxItem,
} from "@rlr/core/inbox";
import { INBOX_HANDLERS } from "@rlr/core/inbox/handlers";
import { can } from "@rlr/core/policy";
import type { UndoSpec } from "@rlr/core/undo";
import InboxKeys from "../components/InboxKeys.tsx";
import Console from "../layouts/Console.astro";
import { adminActor } from "../lib/admin-session";
import { audit, flash, readForm } from "../lib/forms";
import { env, getDb, getStripe, renderEnv } from "../lib/runtime";

const admin = await Astro.locals.admin();
if (!admin) return Astro.redirect("/signin", 303);
const db = getDb();
const settings = await Astro.locals.settings();
const showSnoozed = Astro.url.searchParams.get("snoozed") === "1";
const back = showSnoozed ? "/inbox?snoozed=1" : "/inbox";

/** Whether a card offers Approve/Reject (its decision acts) or just Resolve. */
const decidable = (item: InboxItem) =>
  Boolean(INBOX_HANDLERS[item.type]) &&
  (item.subjectType === "submission" || !["possible_duplicate", "scope_check"].includes(item.type));

/** Decide one item as the owner, and audit it with its undo (DESIGN §8.3). */
async function decide(
  item: InboxItem,
  status: "approved" | "rejected" | "resolved",
  opts: { note?: string; reason?: string; bulk?: boolean } = {},
): Promise<boolean> {
  const note = status === "rejected" ? rejectNote(opts.reason, opts.note) : opts.note?.trim() || undefined;
  let changed = false;
  let undo: UndoSpec | null = null;
  if (status !== "resolved" && decidable(item)) {
    const outcome = await decideWithHandler(
      db,
      item,
      status === "approved" ? "approve" : "reject",
      INBOX_HANDLERS,
      {
        decidedBy: admin.userId,
        note,
        reasonCode: opts.reason || undefined,
        now: new Date(),
        settings,
        renderEnv: renderEnv(),
        stripe: getStripe(),
        kv: env.CONFIG,
      },
    );
    changed = outcome.changed;
    undo = outcome.undo;
  } else {
    changed = await decideInboxItem(db, item.id, {
      status: status === "rejected" ? "rejected" : status === "approved" ? "approved" : "resolved",
      decidedBy: admin.userId,
      note,
      reasonCode: opts.reason || undefined,
    });
  }
  if (changed)
    await audit(admin, Astro.locals.requestId, {
      action: opts.bulk ? "inbox.bulk_approve" : "inbox.decide",
      subjectType: "inbox_item",
      subjectId: item.id,
      diff: {
        status,
        type: item.type,
        title: item.title,
        note: note ?? null,
        reason: opts.reason || null,
        ...(undo ? { undo } : {}),
      },
    });
  return changed;
}

if (Astro.request.method === "POST") {
  const form = await readForm(Astro.request);
  if (!can(adminActor(admin), "inbox.decide").ok)
    return Astro.redirect(flash(back, "Not allowed", "error"), 303);
  const op = form.op ?? "decide";

  if (op === "bulk") {
    // Exactly the list the owner saw, each re-checked: anything that changed since stays put.
    const maxRisk = settings["inbox.low_risk_max"];
    let done = 0;
    for (const id of (form.ids ?? "").split(",").filter(Boolean).slice(0, 100)) {
      const item = await getInboxItem(db, id);
      if (!item || !isLowRisk(item, INBOX_HANDLERS, maxRisk)) continue;
      const status = CLOSE_ONLY_DEFAULT_TYPES.has(item.type) && !decidable(item) ? "resolved" : "approved";
      if (await decide(item, status, { bulk: true })) done++;
    }
    return Astro.redirect(flash(back, `Approved ${done} low-risk item${done === 1 ? "" : "s"}.`), 303);
  }

  const item = await getInboxItem(db, form.id ?? "");
  if (!item) return Astro.redirect(flash(back, "That item is gone.", "error"), 303);
  // Approving price suggestions changes a setting: that needs a passkey check in the last 15 minutes.
  if (
    item.type === "price_suggestions" &&
    form.decision === "approved" &&
    !can(adminActor(admin), "settings.change").ok
  )
    return Astro.redirect("/signin?stepup=1&next=/inbox", 303);

  if (op === "snooze") {
    const choice = SNOOZE_CHOICES.find((c) => c.key === form.for) ?? SNOOZE_CHOICES[1];
    const until = new Date(Date.now() + choice.hours * 3_600_000);
    const ok = await snoozeInboxItem(db, item.id, until);
    if (ok)
      await audit(admin, Astro.locals.requestId, {
        action: "inbox.snooze",
        subjectType: "inbox_item",
        subjectId: item.id,
        diff: { until: until.toISOString() },
      });
    return Astro.redirect(
      flash(
        back,
        ok ? `Snoozed for ${choice.label.toLowerCase()}.` : "Only open items can be snoozed.",
        ok ? "ok" : "error",
      ),
      303,
    );
  }

  if (op === "wake") {
    await wakeInboxItem(db, item.id);
    return Astro.redirect(flash("/inbox", "Back in the inbox."), 303);
  }

  if (op === "trust") {
    // "Trust this author for this kind of item": one step up (to T1 at most), then approve.
    const authorId = itemAuthorId(item);
    const raised = authorId ? await trustAuthor(db, authorId) : null;
    if (authorId && raised)
      await appendAudit(db, {
        actor: { type: "admin", id: admin.userId },
        action: "author.trust",
        subjectType: "author",
        subjectId: authorId,
        diff: { ...raised, via: "inbox", undo: { kind: "author_trust", authorId, to: raised.from } },
        requestId: Astro.locals.requestId,
      });
    const changed = await decide(item, "approved", { note: form.note });
    return Astro.redirect(
      flash(
        back,
        `${changed ? "Approved" : "Already closed"}${raised ? `; the author is now ${raised.to}` : "; the author's trust stays as it is"}.`,
      ),
      303,
    );
  }

  const status =
    form.decision === "rejected" ? "rejected" : form.decision === "approved" ? "approved" : "resolved";
  const changed = await decide(item, status, { note: form.note, reason: form.reason });
  return Astro.redirect(
    flash(back, changed ? `Marked ${status}.` : "That item was already closed.", changed ? "ok" : "error"),
    303,
  );
}

const now = new Date();
const items = await listOpenInbox(db, 200, { snoozed: showSnoozed });
const snoozedCount = showSnoozed ? items.length : await countSnoozed(db);
const lowRisk = showSnoozed
  ? []
  : items.filter((i) => isLowRisk(i, INBOX_HANDLERS, settings["inbox.low_risk_max"]));
const isPair = (p: unknown): p is { bookId: string; otherId: string; reason: string } =>
  typeof p === "object" && p !== null && "bookId" in p && "otherId" in p;
const field = (p: unknown, key: string): string | null => {
  const v = typeof p === "object" && p !== null ? (p as Record<string, unknown>)[key] : null;
  return typeof v === "string" ? v : null;
};
/** Where "e" (edit) goes for a card: the thing to open and fix. */
const editHref = (item: InboxItem): string | null => {
  const p = item.payload;
  if (field(p, "postId")) return `/blog/${field(p, "postId")}`;
  if (item.subjectType === "post" && item.subjectId) return `/blog/${item.subjectId}`;
  if (field(p, "bookId")) return `/catalog/books/${field(p, "bookId")}`;
  if (field(p, "authorId")) return `/catalog/authors/${field(p, "authorId")}`;
  if (field(p, "runId")) return `/editorial/runs/${field(p, "runId")}`;
  return null;
};
const recommendation: Record<string, string> = {
  approve: "Recommends: approve",
  reject: "Recommends: reject",
  edit: "Recommends: edit, then approve",
  escalate: "Needs your judgment",
};
---

<Console title={showSnoozed ? "Inbox: snoozed" : "Inbox"}>
  <p class="inbox-bar">
    {showSnoozed ? <a href="/inbox">← Back to the inbox</a> : <a href="/inbox?snoozed=1">Snoozed ({snoozedCount})</a>}
    {" · "}<a href="/audit?undoable=1">Undo a recent decision</a>
  </p>
  {!showSnoozed && <InboxKeys client:load />}
  {
    lowRisk.length > 0 && (
      <details class="bulk">
        <summary>Approve all low-risk ({lowRisk.length})</summary>
        <p class="muted">
          These would approve themselves anyway, or the review says approve; none is flagged or urgent. Each is checked
          again when you confirm, and each can be undone from the audit log for 30 days.
        </p>
        <ul>
          {lowRisk.map((i) => (
            <li>
              {i.title} <span class="muted">{i.type} · {countdown(i, now)}</span>
            </li>
          ))}
        </ul>
        <form method="post">
          <input type="hidden" name="op" value="bulk" />
          <input type="hidden" name="ids" value={lowRisk.map((i) => i.id).join(",")} />
          <button class="button small" type="submit">Approve these {lowRisk.length}</button>
        </form>
      </details>
    )
  }
  {
    items.length === 0 ? (
      <div class="status-screen">
        <p class="label">[Quest log empty]</p>
        <p>{showSnoozed ? "Nothing is snoozed." : "Nothing needs you right now."}</p>
      </div>
    ) : (
      <table class="inbox-table">
        <thead>
          <tr><th>Priority</th><th>Item</th><th>Opened</th><th>Decide</th></tr>
        </thead>
        <tbody>
          {items.map((item) => (
            <tr data-inbox-item tabindex="-1">
              <td>{item.priority}{item.riskScore !== null && <div class="muted">risk {item.riskScore}</div>}</td>
              <td>
                <strong>{item.title}</strong>
                <div class="muted">{item.type}{item.subjectType ? ` · ${item.subjectType} ${item.subjectId ?? ""}` : ""}</div>
                <div class="countdown">
                  {item.status === "snoozed" && item.snoozedUntil
                    ? `Snoozed until ${item.snoozedUntil.slice(0, 16).replace("T", " ")} UTC · `
                    : ""}
                  {countdown(item, now)}
                </div>
                {item.aiSummary && <p>{item.aiSummary}</p>}
                {item.aiRecommendation && <p class="muted">{recommendation[item.aiRecommendation]}</p>}
                {editHref(item) && <p><a href={editHref(item) ?? ""} data-key="e">Open it (e)</a></p>}
                {item.type === "classification_review" && field(item.payload, "proposalId") && (
                  <form method="post" action="/editorial" class="inline">
                    <input type="hidden" name="proposal" value={field(item.payload, "proposalId") ?? ""} />
                    <input type="hidden" name="back" value="/inbox" />
                    <button class="button small" name="action" value="apply" type="submit">Apply the classification</button>
                    <button class="button small secondary" name="action" value="discard" type="submit">Discard it</button>
                    {field(item.payload, "bookId") && <a href={`/catalog/books/${field(item.payload, "bookId")}`}>the book</a>}
                  </form>
                )}
                {item.type === "editorial_run_held" && field(item.payload, "runId") && (
                  <p><a href={`/editorial/runs/${field(item.payload, "runId")}`}>Review the run's held proposals</a></p>
                )}
                {(item.type === "seed_check" || item.type === "scope_check") && field(item.payload, "bookId") && (
                  <p><a href={`/catalog/books/${field(item.payload, "bookId")}`}>Open the book</a> to hide it, fix it, or override the field.</p>
                )}
                {item.type === "quiz_ready" && field(item.payload, "slug") && (
                  <p><a href={`/quizzes?preview=${field(item.payload, "slug")}`}>Preview it</a>, then publish or retire it from Quizzes.</p>
                )}
                {item.type === "possible_duplicate" && isPair(item.payload) && (
                  <p>
                    Compare <a href={`/catalog/books/${item.payload.bookId}`}>this book</a> with{" "}
                    <a href={`/catalog/books/${item.payload.otherId}`}>the existing one</a> ({item.payload.reason}). Merge from the
                    book page if they're the same; resolve here if not.
                  </p>
                )}
                {item.subjectType === "submission" && (
                  <p>
                    <strong>{field(item.payload, "title")}</strong> by {field(item.payload, "authorName")} ({field(item.payload, "genre")}). Approve publishes it; reject tells the author why (use the note).
                    {field(item.payload, "duplicateOf") && <> It may be <a href={`/catalog/books/${field(item.payload, "duplicateOf")}`}>this existing book</a>.</>}
                    {field(item.payload, "authorId") && <> <a href={`/catalog/authors/${field(item.payload, "authorId")}`}>The author's profile</a>.</>}
                  </p>
                )}
                {item.type === "protected_change" && (
                  <p>
                    {field(item.payload, "reason")}. <a href={`/catalog/books/${field(item.payload, "bookId")}`}>The book</a> · the change is under Details. Approve applies it as the author.
                  </p>
                )}
                {item.type === "verification_manual" && (
                  <p>
                    Look for <code>{field(item.payload, "code")}</code> at <strong>{field(item.payload, "target")}</strong> ({field(item.payload, "method")}). {field(item.payload, "check")}{" "}
                    <a href={`/catalog/authors/${field(item.payload, "authorId")}`}>The profile</a>.
                  </p>
                )}
                {item.type === "claim_conflict" && (
                  <p>
                    Someone else claims <a href={`/catalog/authors/${field(item.payload, "authorId")}`}>{field(item.payload, "name")}</a>, which already has members. Approve adds them as an owner (you can remove members on the profile page).
                  </p>
                )}
                {item.type === "guest_pitch" && (
                  <p>
                    <strong>{field(item.payload, "title")}</strong>: {field(item.payload, "pitch")} · <a href={`/blog/${field(item.payload, "postId")}`}>The post</a>. Approve accepts the pitch; reject declines it (the note goes to the author).
                  </p>
                )}
                {item.type === "news_brief" && (
                  <div>
                    <p><strong>{field(item.payload, "headline")}</strong></p>
                    <p>{field(item.payload, "body")}</p>
                    <p class="muted">{field(item.payload, "why")}</p>
                    <ul>
                      {((item.payload as { sources?: { url: string }[] } | null)?.sources ?? []).map((s) => (
                        <li><a href={s.url} rel="noopener noreferrer">{s.url}</a></li>
                      ))}
                    </ul>
                    <p class="muted">Approve publishes it as a news brief citing these pages.</p>
                  </div>
                )}
                {item.type === "post_review" && (
                  <p>
                    <a href={`/blog/${field(item.payload, "postId") ?? item.subjectId}`}>Read it in the editor</a>. Approve
                    publishes it (guest posts and interviews take their calendar slot); reject keeps it off the site.
                  </p>
                )}
                {item.type === "ad_review" && (
                  <div>
                    <p><strong>{field(item.payload, "headline")}</strong></p>
                    {field(item.payload, "body") && <p>{field(item.payload, "body")}</p>}
                    <p class="muted">
                      {field(item.payload, "bookId") && <><a href={`/catalog/books/${field(item.payload, "bookId")}`}>The book</a> · </>}
                      <a href={`/billing/campaigns/${field(item.payload, "campaignId") ?? item.subjectId}`}>The campaign and its payment</a>.
                      Approve schedules it; reject releases its dates and refunds in full (the note goes to the author).
                    </p>
                  </div>
                )}
                {item.type === "price_suggestions" && (
                  <table>
                    <thead><tr><th>Placement</th><th>Now</th><th>Suggested</th><th>Readers a period</th><th>Sold (4 weeks)</th></tr></thead>
                    <tbody>
                      {((item.payload as { suggestions?: { name: string; currentCents: number; suggestedCents: number; audience: number; sellThrough: number | null }[] } | null)?.suggestions ?? []).map((x) => (
                        <tr>
                          <td>{x.name}</td>
                          <td>${(x.currentCents / 100).toFixed(2)}</td>
                          <td><strong>${(x.suggestedCents / 100).toFixed(2)}</strong></td>
                          <td>{x.audience}</td>
                          <td>{x.sellThrough === null ? "–" : `${Math.round(x.sellThrough * 100)}%`}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
                {item.type === "billing_mismatch" && (
                  <p>
                    Check the checkout <code>{field(item.payload, "sessionId")}</code> in the Stripe dashboard
                    {field(item.payload, "orderId") && <> against <a href={`/billing/orders/${field(item.payload, "orderId")}`}>the order</a></>}.
                    Resolve once they agree.
                  </p>
                )}
                {item.type === "dispute" && (
                  <p>
                    <a href={`/billing/orders/${field(item.payload, "orderId") ?? item.subjectId}`}>The order</a>. Respond to the
                    dispute in the Stripe dashboard with the booking record; the order updates itself when it closes.
                  </p>
                )}
                {item.type === "author_report" && (
                  <p>{field(item.payload, "text")} · <a href={`/catalog/books/${field(item.payload, "bookId")}`}>The book</a></p>
                )}
                {item.payload != null && (
                  <details>
                    <summary>Details</summary>
                    <pre>{JSON.stringify(item.payload, null, 2)}</pre>
                  </details>
                )}
              </td>
              <td class="when">{item.createdAt.slice(0, 16).replace("T", " ")}</td>
              <td class="decide">
                {item.status === "snoozed" ? (
                  <form method="post" class="inline">
                    <input type="hidden" name="id" value={item.id} />
                    <button class="button small" name="op" value="wake" type="submit">Wake now</button>
                  </form>
                ) : (
                  <>
                    <form method="post" class="stack">
                      <input type="hidden" name="id" value={item.id} />
                      <input type="text" name="note" placeholder="Note (optional)" maxlength="500" aria-label="Note" />
                      {decidable(item) ? (
                        <>
                          <label>
                            Reason if rejecting
                            <select name="reason">
                              <option value="">None</option>
                              {REJECT_REASONS.map((r) => (
                                <option value={r.code}>{r.label}</option>
                              ))}
                            </select>
                          </label>
                          <div class="inline">
                            <button class="button small" name="decision" value="approved" type="submit" data-key="a">Approve</button>
                            <button class="button small secondary" name="decision" value="rejected" type="submit" data-key="r">Reject</button>
                            {itemAuthorId(item) && (
                              <button class="button small secondary" name="op" value="trust" type="submit">
                                Approve &amp; trust author
                              </button>
                            )}
                          </div>
                        </>
                      ) : (
                        <button class="button small" name="decision" value="resolved" type="submit" data-key="a">Resolve</button>
                      )}
                    </form>
                    <form method="post" class="inline">
                      <input type="hidden" name="id" value={item.id} />
                      <input type="hidden" name="op" value="snooze" />
                      <select name="for" aria-label="Snooze for">
                        {SNOOZE_CHOICES.map((c) => (
                          <option value={c.key} selected={c.key === "1d"}>{c.label}</option>
                        ))}
                      </select>
                      <button class="button small secondary" type="submit" data-key="s">Snooze</button>
                    </form>
                  </>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</Console>

<style>
  .inbox-bar {
    margin-bottom: var(--space-3);
  }
  .bulk {
    margin: 0 0 var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-small);
  }
  .countdown {
    font-family: var(--font-system);
    font-size: 0.85rem;
    color: var(--color-primary);
  }
  .decide .stack {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .when {
    white-space: nowrap;
  }
  /* Touch screens have no keys to press. */
  @media (hover: none) and (pointer: coarse) {
    :global(.keys-hint) {
      display: none;
    }
  }
  /* On a phone each item is a card with its decision underneath: the inbox is where the owner acts. */
  @media (max-width: 48rem) {
    .inbox-table,
    .inbox-table > tbody,
    .inbox-table > tbody > tr,
    .inbox-table > tbody > tr > td {
      display: block;
    }
    .inbox-table {
      overflow: visible;
      background: none;
    }
    .inbox-table > thead {
      display: none;
    }
    .inbox-table > tbody > tr {
      margin-bottom: var(--space-3);
      padding: var(--space-3);
      border: 1px solid var(--color-line);
      border-radius: var(--radius);
      background: var(--color-surface);
    }
    .inbox-table > tbody > tr > td {
      padding: var(--space-1) 0;
      border: 0;
    }
    /* No keys to move with on a phone: the cursor's place says what the number is. */
    .inbox-table > tbody > tr > td:first-child::before {
      content: "Priority";
      color: var(--color-muted);
      opacity: 1;
      transform: none;
    }
  }
  tr[data-inbox-item]:focus {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }
  /* j / k move a menu cursor down the cards. */
  tr[data-inbox-item] > td:first-child::before {
    content: "▶";
    display: inline-block;
    margin-inline-end: var(--space-1);
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  tr[data-inbox-item]:focus > td:first-child::before {
    opacity: 1;
    transform: none;
  }
</style>
