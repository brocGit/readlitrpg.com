---
import { hoursBetween, nowIso } from "@rlr/core";
import { countOpenInbox } from "@rlr/core/inbox";
import { HEARTBEAT_KV_KEY } from "@rlr/core/scheduler";
import { jobRuns } from "@rlr/core/schema";
import { desc } from "drizzle-orm";
import Console from "../layouts/Console.astro";
import { env, getDb } from "../lib/runtime";

const db = getDb();
const [heartbeat, inbox, runs, settings] = await Promise.all([
  env.CONFIG.get(HEARTBEAT_KV_KEY),
  countOpenInbox(db),
  db.select().from(jobRuns).orderBy(desc(jobRuns.queuedAt)).limit(10),
  Astro.locals.settings(),
]);
const heartbeatAgeHours = heartbeat ? hoursBetween(heartbeat, nowIso()) : null;
const heartbeatOk = heartbeatAgeHours !== null && heartbeatAgeHours < 0.25;
const switches = Object.entries(settings).filter(([k]) => k.startsWith("flags."));
---

<Console title="Dashboard">
  <section class="grid">
    <div class="status-screen">
      <p class="label">Scheduler</p>
      <p class={heartbeatOk ? "light ok" : "light warn"}>
        {heartbeat ? (heartbeatOk ? "Heartbeat is running." : `Last heartbeat ${heartbeatAgeHours?.toFixed(1)} h ago.`) : "No heartbeat recorded yet."}
      </p>
    </div>
    <div class="status-screen">
      <p class="label">Inbox</p>
      <p class="big"><a href="/inbox">{inbox.open}</a></p>
      <p>{inbox.open === 0 ? "Nothing needs you." : "open"}{inbox.urgent > 0 && <strong class="urgent"> · {inbox.urgent} urgent</strong>}</p>
    </div>
    <div class="status-screen">
      <p class="label">Switches</p>
      <ul class="switches">
        {switches.map(([k, v]) => <li>{k.replace("flags.", "")}: <strong>{String(v)}</strong></li>)}
      </ul>
    </div>
  </section>

  <h2>Recent job runs</h2>
  {
    runs.length === 0 ? (
      <p class="muted">No jobs have run yet.</p>
    ) : (
      <table>
        <thead>
          <tr><th>Job</th><th>Status</th><th>Queued</th><th>Items</th><th>Error</th></tr>
        </thead>
        <tbody>
          {runs.map((r) => (
            <tr>
              <td>{r.job}</td>
              <td>{r.status}</td>
              <td>{r.queuedAt.slice(0, 16).replace("T", " ")}</td>
              <td>{r.items ?? ""}</td>
              <td><code>{r.error?.slice(0, 120) ?? ""}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</Console>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin-bottom: var(--space-8);
  }
  .switches {
    margin: 0;
    padding-left: 1.2rem;
  }
  .big {
    font-size: 1.8rem;
    margin: 0;
  }
  .big a {
    text-decoration: none;
  }
  .urgent {
    color: var(--color-danger);
  }
  /* A status light: steady green while the heartbeat runs, amber when it's late. */
  .light::before {
    content: "";
    display: inline-block;
    inline-size: 0.6em;
    block-size: 0.6em;
    margin-inline-end: var(--space-2);
    border-radius: 50%;
    vertical-align: 0.05em;
  }
  .light.ok::before {
    background: var(--color-primary);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-primary) 50%, transparent);
    animation: pulse 2.4s var(--ease-out) infinite;
  }
  .light.warn::before {
    background: var(--color-accent);
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 0.5em transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
</style>
