---
// A list of posts, newest first (blog, news and author pages).
import { POST_TYPE_LABEL, type PostSummary, postPath } from "@rlr/core/content";
import { formatDate } from "@rlr/core/site";
import { patchTag } from "../../lib/site";

interface Props {
  posts: PostSummary[];
  showType?: boolean;
}
const { posts, showType = true } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((p) => (
      <li>
        <p class="muted small">
          {showType && <span class="post-type">{POST_TYPE_LABEL[p.type]}</span>}
          {p.type === "daily" && <span class="patch-tag">{patchTag(p.publishedAt)}</span>}
          {showType && " · "}
          <time datetime={p.publishedAt}>{formatDate(p.publishedAt.slice(0, 10), "day")}</time>
          {p.byline ? <> · {p.byline.name}</> : p.bylineName ? <> · {p.bylineName}</> : null}
        </p>
        <h2>
          <a href={postPath(p)}>{p.title}</a>
        </h2>
        {p.dek && <p>{p.dek}</p>}
      </li>
    ))
  }
</ul>
