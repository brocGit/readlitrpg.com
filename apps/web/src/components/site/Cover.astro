---
// A cover from the media domain, or a generated placeholder card when we have no licensed cover
// (DESIGN §16.5). Covers below the fold load lazily.
import type { Cover } from "@rlr/core/site";
import { coverImage } from "../../lib/site";

interface Props {
  cover: Cover | null;
  title: string;
  author?: string | undefined;
  width?: number;
  eager?: boolean;
}
const { cover, title, author, width = 120, eager = false } = Astro.props;
const img = cover ? coverImage(cover, width) : null;
const size = width >= 200 ? "large" : width <= 80 ? "tiny" : "small";
// Placeholders are bound like books in one of six cloth colors, chosen from the title so a book
// always gets the same one (the page is cached and shared, DESIGN §9.10).
const cloth = [...title].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7) % 6;
---

{
  img ? (
    <img
      class={`cover ${size}`}
      src={img.src}
      srcset={img.srcset}
      sizes={img.sizes}
      width={img.width}
      height={img.height}
      alt={`Cover of ${title}`}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  ) : (
    <div class={`cover placeholder cloth-${cloth} ${size}`} role="img" aria-label={`No cover yet for ${title}`}>
      <span class="ph-title">{title}</span>
      {author && <span class="ph-author">{author}</span>}
    </div>
  )
}
