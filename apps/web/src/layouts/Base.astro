---
import { jsonLdText } from "@rlr/core/site";
import { siteOgUrl } from "../lib/site";
import "@rlr/ui/tokens.css";
import "@rlr/ui/base.css";

interface Props {
  title: string;
  description?: string;
  /**
   * Pages that carry one-time tokens in the URL must not leak them to other sites via Referer.
   * "same-origin", not "no-referrer": the latter makes browsers send `Origin: null` on the page's own
   * form posts, which the origin check refuses.
   */
  noReferrer?: boolean;
  /** Personal or parameter pages (shared results, searches) stay out of search engines. */
  noIndex?: boolean;
  /** A share card path or absolute URL, for link previews. */
  ogImage?: string | null;
  /** The page's canonical path (DESIGN §17.2). Filtered and parameter pages leave it out. */
  canonical?: string;
  /** Structured data for search engines (schema.org JSON-LD). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = "Tell it three books you loved. It finds your next LitRPG.",
  noReferrer = false,
  noIndex = false,
  ogImage,
  canonical,
  jsonLd = [],
} = Astro.props;
const canonicalOrigin = Astro.site?.origin ?? Astro.url.origin;
const fullTitle = title === "ReadLitRPG" ? title : `${title} · ReadLitRPG`;
// Amazon's required disclosure, shown site-wide once store links carry our tag (DESIGN §16.4).
const affiliate = Boolean((await Astro.locals.settings())["affiliate.amazon_tag_web"]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noReferrer && <meta name="referrer" content="same-origin" />}
    {noIndex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage ?? siteOgUrl(), canonicalOrigin).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={new URL(canonical, canonicalOrigin).toString()} />}
    {canonical && <meta property="og:url" content={new URL(canonical, canonicalOrigin).toString()} />}
    {jsonLd.length > 0 && <script type="application/ld+json" is:inline set:html={jsonLdText(jsonLd.length === 1 ? (jsonLd[0] ?? {}) : jsonLd)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="wordmark" href="/" aria-label="ReadLitRPG home"><span aria-hidden="true">[</span>ReadLitRPG<span aria-hidden="true">]</span></a>
        <nav aria-label="Site">
          <a href="/match">Match</a>
          <a href="/find">Find</a>
          <a href="/quiz">Quizzes</a>
          <a href="/lists">Lists</a>
          <a href="/news">News</a>
          <a href="/account">Account</a>
        </nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer container muted">
      <p>ReadLitRPG: a free discovery engine for LitRPG, progression fantasy and GameLit.</p>
      <p>
        <a href="/new">New &amp; upcoming</a> · <a href="/tags">Tags</a> · <a href="/lists">Lists</a> ·
        <a href="/quiz">Quizzes</a> · <a href="/subscribe">Patch Notes (weekly email)</a> ·
        <a href="/news">News</a> · <a href="/blog">Blog</a> ·
        <a href="/for-authors">For authors</a> ·
        <a href="/feeds/releases.xml">RSS</a>
      </p>
      {affiliate && <p>As an Amazon Associate I earn from qualifying purchases.</p>}
    </footer>
    <script>
      // A first-party page view (DESIGN §11.6): the path and the referring site, nothing else. No
      // cookies, no identifiers, and nothing at all when the browser asks not to be tracked.
      const nav = navigator as Navigator & { globalPrivacyControl?: boolean; doNotTrack?: string | null };
      if (!nav.globalPrivacyControl && nav.doNotTrack !== "1" && typeof nav.sendBeacon === "function") {
        let r = "";
        try {
          r = document.referrer ? new URL(document.referrer).host : "";
        } catch {
          r = "";
        }
        const ads = [...document.querySelectorAll<HTMLElement>("[data-ad]")]
          .slice(0, 6)
          .map((el) => [el.dataset.ad, el.dataset.slot]);
        nav.sendBeacon("/e", JSON.stringify({ p: location.pathname, r, ...(ads.length ? { a: ads } : {}) }));
        // Viewable: at least half of the ad on screen for a second (DESIGN §11.6), reported once.
        if (ads.length && "IntersectionObserver" in window) {
          const seen: string[][] = [];
          let flush: number | undefined;
          const timers = new Map<Element, number>();
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                const el = e.target as HTMLElement;
                if (e.isIntersecting) {
                  timers.set(
                    el,
                    window.setTimeout(() => {
                      io.unobserve(el);
                      seen.push([el.dataset.ad ?? "", el.dataset.slot ?? ""]);
                      clearTimeout(flush);
                      flush = window.setTimeout(() => nav.sendBeacon("/e", JSON.stringify({ p: location.pathname, v: seen.splice(0) })), 500);
                    }, 1000),
                  );
                } else clearTimeout(timers.get(el));
              }
            },
            { threshold: 0.5 },
          );
          for (const el of document.querySelectorAll("[data-ad]")) io.observe(el);
        }
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
  }
  .wordmark {
    font-family: var(--font-system);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-ink);
    text-decoration: none;
  }
  .wordmark span {
    color: var(--color-accent);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  main {
    padding-block: var(--space-8) var(--space-12);
    min-height: 60vh;
  }
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-6);
    font-size: 0.9rem;
  }
</style>
