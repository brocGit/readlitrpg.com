---
import { consentsFor, getReaderProfile } from "@rlr/core/readers";
import AccountNav from "../../components/AccountNav.astro";
import AddPasskey from "../../components/AddPasskey";
import AttachTakes from "../../components/AttachTakes";
import SignOut from "../../components/SignOut";
import Base from "../../layouts/Base.astro";
import { classInfo, levelInfo } from "../../lib/readers";
import { getAuth, getDb } from "../../lib/runtime";
import "../../styles/discover.css";
import "../../styles/reader.css";

// Signed-in only (see src/routes.ts). Never cached.
const session = await Astro.locals.session();
if (!session) return Astro.redirect("/signin?next=/account", 303);

const db = getDb();
const [passkeys, profile, consents] = await Promise.all([
  getAuth().api.listPasskeys({ headers: Astro.request.headers }),
  getReaderProfile(db, session.userId),
  consentsFor(db, session.userId),
]);
const level = levelInfo(profile.level);
const cls = classInfo(profile.readerClass);
const weekly = consents.some((c) => c.list === "weekly_digest" && c.status === "active");
---

<Base title="Your account" noIndex>
  <div class="prose">
    <h1>Your account</h1>
    <p>Signed in as <strong>{session.email}</strong>.</p>
    <AccountNav />

    <section class="status-screen level">
      <p class="label">[Profile · Level {level.level}: {level.title}]</p>
      <progress max="100" value={level.xp} aria-label={`Profile level ${level.level} of 5`}></progress>
      {cls && <p>Class: <strong>{cls.name}</strong>. {cls.tagline}</p>}
      {level.next ? (
        <p>Next level: <a href={level.next.href}>{level.next.text}</a>. Each level sharpens your matches.</p>
      ) : (
        <p>Max level. Your appraisals help every reader's matches too.</p>
      )}
    </section>

    <p>
      <a class="button" href="/account/preferences">See my matches</a>
      {!weekly && <a class="button secondary" href="/account/email">Get Patch Notes weekly</a>}
    </p>

    <h2>Passkeys</h2>
    {
      passkeys.length === 0 ? (
        <p class="muted">No passkeys yet. A passkey lets you sign in without waiting for an email.</p>
      ) : (
        <ul>
          {passkeys.map((p) => (
            <li>
              {p.name ?? "Passkey"}
              <span class="muted"> · added {p.createdAt ? new Date(p.createdAt).toISOString().slice(0, 10) : "earlier"}</span>
            </li>
          ))}
        </ul>
      )
    }
    <AddPasskey client:load />

    <h2>Sign out</h2>
    <SignOut client:load />
  </div>
  <AttachTakes client:load />
</Base>
