---
import Base from "../layouts/Base.astro";
import "../styles/discover.css";
import "../styles/reader.css";

// For authors (DESIGN §10): what a free listing gets you, and the way in.
---

<Base title="For authors" description="List your LitRPG and progression fantasy books free, reach readers who match your books, and keep release dates right." canonical="/for-authors">
  <div class="prose">
    <h1>For authors</h1>
    <p class="lead">Readers here tell us what they love and we match them to books. Listing yours is free.</p>
    <ul>
      <li><strong>Matched to the right readers.</strong> Your book shows up for readers whose tastes fit it, with the reason why.</li>
      <li><strong>Release dates readers can follow.</strong> Followers get an email the day your book is out.</li>
      <li><strong>Your listing, your words.</strong> Once you're verified, your blurb, links and dates go live straight away.</li>
      <li><strong>Honest numbers.</strong> Page views, match appearances and follows for each book. Totals only: we never show which readers.</li>
      <li><strong>No surprises.</strong> If anyone else changes your listing, we email you that day.</li>
    </ul>
    <p><a class="button" href="/dashboard/start">I'm an author</a></p>
    <p class="muted small">You'll sign in with a passkey or an email link. Many books are already listed: you can claim yours in a minute.</p>
  </div>
</Base>
