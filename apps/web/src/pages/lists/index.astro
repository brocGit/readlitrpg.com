---
import { LIVING_LISTS } from "@rlr/core/match";
import ListCard from "../../components/site/ListCard.astro";
import Base from "../../layouts/Base.astro";
import { listPreviews } from "../../lib/match";
import "../../styles/discover.css";
import "../../styles/site.css";

Astro.cache.set({ tags: ["lists"] });
// Cards show the intro's first sentence; the list page has the rest.
const firstSentence = (text: string) => text.match(/^.*?[.!?](\s|$)/)?.[0]?.trim() ?? text;
const previews = await listPreviews(
  LIVING_LISTS.map((l) => l.slug),
  await Astro.locals.settings(),
);
---

<Base title="Reading lists" description="LitRPG and progression fantasy lists that update themselves as the catalog grows.">
  <h1>Reading lists</h1>
  <p class="muted">Each list is a saved search: it updates itself as books are added and readers appraise them.</p>
  <ul class="cards lists-board">
    {
      LIVING_LISTS.map((l) => (
        <ListCard slug={l.slug} title={l.title} blurb={firstSentence(l.intro)} preview={previews.get(l.slug)} />
      ))
    }
  </ul>
</Base>
