---
// Title, series and author lookup (Appendix A /search). Results pages stay out of search engines.
import { searchPublished } from "@rlr/core/match";
import Base from "../layouts/Base.astro";
import { getDb } from "../lib/runtime";
import "../styles/discover.css";
import "../styles/site.css";

const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 80);
const hits = q.length >= 2 ? await searchPublished(getDb(), q, 30) : [];
Astro.cache.set({ tags: ["search"] });
---

<Base title={q ? `Search: ${q}` : "Search"} description="Find a LitRPG book by title, series or author." noIndex>
  <h1>Search</h1>
  <form class="search-form" method="get" action="/search" role="search">
    <input type="search" name="q" value={q} placeholder="Title, series or author" aria-label="Title, series or author" />
    <button class="button" type="submit">Search</button>
  </form>
  {q.length >= 2 && hits.length === 0 && <p class="status-screen">[No loot found] Nothing matches "{q}" yet. Try a shorter title or the author's name.</p>}
  {
    hits.length > 0 && (
      <ul class="book-list">
        {hits.map((h) => (
          <li>
            <a href={`/books/${h.slug}`}><strong>{h.title}</strong></a>
            <span class="muted"> {h.authors}{h.series && ` · ${h.series}${h.position ? ` #${h.position}` : ""}`}</span>
          </li>
        ))}
      </ul>
    )
  }
  <p class="muted">Looking for something to read, not a particular book? <a href="/match">Get matched</a> or <a href="/find">filter the catalog</a>.</p>
</Base>
